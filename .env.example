# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API
# Only the PUBLIC anon key belongs here. Never put the service_role key in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- Selfie avatars (Avaturn) — create a project at https://developer.avaturn.me ----
# SERVER-ONLY SECRET (no VITE_ prefix, so it is never sent to the browser). Enables the in-app
# selfie camera (front + 2 side photos) and editor sessions via /api/avaturn. Requires an Avaturn API plan.
AVATURN_API_KEY=
# Optional fallback without the API: the public project URL; the Avaturn editor then captures the selfie itself.
VITE_AVATURN_URL=

# The public address people open from the QR code (your Vercel URL). Leave empty to use the current address.
VITE_PUBLIC_URL=
